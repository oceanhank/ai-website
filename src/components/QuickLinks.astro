---
interface LinkItem {
  label: string;
  href: string;
}

interface Props {
  links: LinkItem[];
}

const { links } = Astro.props;
---

<div class="quicklinks">
  {links.map((link) => (
    <a href={link.href} class="quicklinks__item">
      <span class="quicklinks__label">{link.label}</span>
      <span class="quicklinks__arrow" aria-hidden="true">↗</span>
    </a>
  ))}
</div>

<style>
  .quicklinks {
    display: flex;
    flex-wrap: wrap;
    border-top: 2px solid var(--color-black);
    border-bottom: 2px solid var(--color-black);
    background: var(--color-black);
  }

  .quicklinks__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.9rem 1.5rem;
    color: var(--color-white);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    border-right: 1px solid var(--color-white);
    flex: 1 1 160px;
    transition: background 0.15s, color 0.15s;
  }

  .quicklinks__item:last-child {
    border-right: none;
  }

  .quicklinks__item:hover {
    background: var(--color-white);
    color: var(--color-black);
  }

  .quicklinks__arrow {
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .quicklinks__item {
      border-right: none;
      border-bottom: 1px solid var(--color-white);
    }

    .quicklinks__item:last-child {
      border-bottom: none;
    }
  }
</style>
