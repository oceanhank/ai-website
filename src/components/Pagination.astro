---
interface Props {
  currentPage: number;
  totalPages: number;
  base?: string;
}

const { currentPage, totalPages, base = '' } = Astro.props;

function pageHref(n: number): string {
  if (n === 1) return `${base}/blog`;
  return `${base}/blog/page/${n}`;
}
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="Blog pagination">
    {currentPage > 1 ? (
      <a href={pageHref(currentPage - 1)} class="pagination__link">← Previous</a>
    ) : (
      <span class="pagination__link pagination__link--disabled" aria-disabled="true">← Previous</span>
    )}

    <span class="pagination__info">Page {currentPage} of {totalPages}</span>

    {currentPage < totalPages ? (
      <a href={pageHref(currentPage + 1)} class="pagination__link">Next →</a>
    ) : (
      <span class="pagination__link pagination__link--disabled" aria-disabled="true">Next →</span>
    )}
  </nav>
)}
