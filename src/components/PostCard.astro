---
interface Props {
  title: string;
  slug: string;
  excerpt: string;
  date: string;
  imageSrc?: string | null;
  imageAlt?: string;
  base?: string;
}

const {
  title,
  slug,
  excerpt,
  date,
  imageSrc,
  imageAlt = '',
  base = '',
} = Astro.props;

const postUrl = `${base}/blog/${slug}`;
const urlDisplay = `/blog/${slug}`;
---

<article class="post-card">
  <!-- Browser window chrome -->
  <div class="post-card__chrome">
    <span class="post-card__dots" aria-hidden="true">
      <span class="post-card__dot"></span>
      <span class="post-card__dot"></span>
    </span>
    <span class="post-card__url">{urlDisplay}</span>
  </div>

  <!-- Featured image -->
  <div class="post-card__image-wrap">
    {imageSrc ? (
      <img src={imageSrc} alt={imageAlt} class="post-card__image" loading="lazy" />
    ) : (
      <div class="post-card__image-placeholder" aria-hidden="true"></div>
    )}
  </div>

  <!-- Content -->
  <div class="post-card__body">
    <h2 class="post-card__title">{title}</h2>
    <p class="post-card__excerpt">{excerpt}</p>
    <div class="post-card__footer">
      <time class="post-card__date" datetime={date}>{date}</time>
      <a href={postUrl} class="btn post-card__btn">Read more</a>
    </div>
  </div>
</article>

<style>
  .post-card {
    border: 2px solid var(--color-black);
    box-shadow: 4px 4px 0 var(--color-black);
    background: var(--color-white);
    display: flex;
    flex-direction: column;
    border-radius: 0;
    overflow: hidden;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .post-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--color-black);
  }

  /* Browser chrome bar */
  .post-card__chrome {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.75rem;
    background: var(--color-gray-light);
    border-bottom: 2px solid var(--color-black);
  }

  .post-card__dots {
    display: flex;
    gap: 5px;
    flex-shrink: 0;
  }

  .post-card__dot {
    width: 8px;
    height: 8px;
    background: var(--color-black);
    border-radius: 50%;
    display: block;
  }

  .post-card__url {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-black);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
    text-align: center;
  }

  /* Image area */
  .post-card__image-wrap {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    border-bottom: 2px solid var(--color-black);
  }

  .post-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-card__image-placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-gray-light);
  }

  /* Content */
  .post-card__body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .post-card__title {
    font-family: var(--font-heading);
    font-size: var(--font-card-title-size);
    font-weight: var(--font-card-title-weight);
    line-height: 1.2;
    margin-bottom: 0.6rem;
  }

  .post-card__excerpt {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #333;
    flex: 1;
    margin-bottom: 1rem;
  }

  .post-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .post-card__date {
    font-size: 0.8rem;
    font-weight: 600;
    font-family: var(--font-mono);
    opacity: 0.7;
  }

  .post-card__btn {
    font-size: 0.8rem;
    padding: 0.35rem 0.9rem;
  }
</style>
