---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import { fetchPosts, getFeaturedImageUrl, getFeaturedImageAlt, formatDate, truncateExcerpt } from '../../lib/wordpress';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { posts, totalPages } = await fetchPosts(1, 10);
const currentPage = 1;
---

<BaseLayout
  title="Blog"
  description="All posts about AI, machine learning, and technology."
>
  <section class="section">
    <div class="container">
      <h1 class="page-title">Blog</h1>

      {posts.length === 0 ? (
        <p class="empty-state">No posts yet.</p>
      ) : (
        <div class="post-grid">
          {posts.map((post) => (
            <PostCard
              title={post.title.rendered}
              slug={post.slug}
              excerpt={truncateExcerpt(post.excerpt.rendered, 150)}
              date={formatDate(post.date)}
              imageSrc={getFeaturedImageUrl(post)}
              imageAlt={getFeaturedImageAlt(post)}
              base={base}
            />
          ))}
        </div>
      )}

      <Pagination currentPage={currentPage} totalPages={totalPages} base={base} />
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    font-family: var(--font-heading);
    font-size: var(--font-h2-size);
    font-weight: var(--font-h2-weight);
    margin-bottom: 2rem;
    border-bottom: 2px solid var(--color-black);
    padding-bottom: 0.75rem;
  }

  .empty-state {
    font-style: italic;
    opacity: 0.6;
    padding: 2rem 0;
  }
</style>
