---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { fetchPosts, getFeaturedImageUrl, getFeaturedImageAlt, formatDate, truncateExcerpt, getPostSlug } from '../../../lib/wordpress';

export async function getStaticPaths() {
  // Fetch page 1 to get totalPages
  const first = await fetchPosts(1, 10);
  const { totalPages } = first;

  // Generate paths for pages 2..N (page 1 is handled by blog/index.astro)
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { n: String(i + 2) },
    props: { page: i + 2, totalPages },
  }));
}

interface Props {
  page: number;
  totalPages: number;
}

const { page, totalPages } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { posts } = await fetchPosts(page, 10);
---

<BaseLayout
  title={`Blog — Page ${page}`}
  description={`AI blog posts — page ${page} of ${totalPages}.`}
>
  <section class="section">
    <div class="container">
      <h1 class="page-title">Blog</h1>

      <div class="post-grid">
        {posts.map((post) => (
          <PostCard
            title={post.title.rendered}
            slug={getPostSlug(post)}
            excerpt={truncateExcerpt(post.excerpt.rendered, 150)}
            date={formatDate(post.date)}
            imageSrc={getFeaturedImageUrl(post)}
            imageAlt={getFeaturedImageAlt(post)}
            base={base}
          />
        ))}
      </div>

      <Pagination currentPage={page} totalPages={totalPages} base={base} />
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    font-family: var(--font-heading);
    font-size: var(--font-h2-size);
    font-weight: var(--font-h2-weight);
    margin-bottom: 2rem;
    border-bottom: 2px solid var(--color-black);
    padding-bottom: 0.75rem;
  }
</style>
