---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchAllPosts, fetchPostBySlug, getFeaturedImageUrl, getFeaturedImageAlt, formatDate, truncateExcerpt } from '../../lib/wordpress';

export async function getStaticPaths() {
  const posts = await fetchAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = await fetchPostBySlug(slug!);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const featuredImageUrl = getFeaturedImageUrl(post);
const featuredImageAlt = getFeaturedImageAlt(post);

const pubDate = formatDate(post.date);
const modDate = formatDate(post.modified);
const showModified = modDate !== pubDate;

const descriptionText = truncateExcerpt(post.excerpt.rendered, 160);
---

<BaseLayout
  title={post.title.rendered}
  description={descriptionText}
  ogTitle={post.title.rendered}
  ogDescription={descriptionText}
  ogImage={featuredImageUrl ?? undefined}
>
  <div class="post-page">
    <div class="container">
      <nav class="post-page__back">
        <a href={`${base}/blog`} class="back-link">← Back to Blog</a>
      </nav>

      <header class="post-page__header">
        <h1 class="post-page__title" set:html={post.title.rendered} />
        <div class="post-page__meta">
          {showModified ? (
            <span>Published: {pubDate} | Updated: {modDate}</span>
          ) : (
            <time datetime={post.date}>{pubDate}</time>
          )}
        </div>
      </header>

      {featuredImageUrl && (
        <div class="post-page__featured-image">
          <img
            src={featuredImageUrl}
            alt={featuredImageAlt}
            class="post-page__img"
          />
        </div>
      )}

      <article class="post-content" set:html={post.content.rendered} />
    </div>
  </div>
</BaseLayout>

<style>
  .post-page {
    padding: 3rem 0 4rem;
  }

  .post-page__back {
    margin-bottom: 2rem;
  }

  .back-link {
    font-weight: 700;
    font-size: 0.875rem;
    text-decoration: none;
    border: 2px solid var(--color-black);
    padding: 0.35rem 0.9rem;
    display: inline-block;
  }

  .back-link:hover {
    background: var(--color-black);
    color: var(--color-white);
  }

  .post-page__header {
    margin-bottom: 2rem;
  }

  .post-page__title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 5vw, 3rem);
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .post-page__meta {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    opacity: 0.7;
    border-left: 3px solid var(--color-black);
    padding-left: 0.75rem;
  }

  .post-page__featured-image {
    margin-bottom: 2.5rem;
  }

  .post-page__img {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    border: 2px solid var(--color-black);
    box-shadow: 4px 4px 0 var(--color-black);
  }

  .post-content {
    max-width: 72ch;
  }
</style>
